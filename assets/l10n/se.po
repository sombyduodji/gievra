msgstr "kevyt, hartiat rentona"

#: lib/injury_data.dart:242
msgid "Niska"
msgstr "Niska"

#: lib/injury_data.dart:243
msgid ""
"Niskan ja hartioiden kipu ja jäykkyys ilman vammaa. Liikkeessä "
"pysyminen ja asteittainen niska-hartiaseudun vahvistaminen auttavat "
"yleensä. Jos käteen säteilee kipua ja siinä on puutumista tai "
"heikkoutta, hakeudu arvioon."
msgstr ""
"Niskan ja hartioiden kipu ja jäykkyys ilman vammaa. Liikkeessä "
"pysyminen ja asteittainen niska-hartiaseudun vahvistaminen auttavat "
"yleensä. Jos käteen säteilee kipua ja siinä on puutumista tai "
"heikkoutta, hakeudu arvioon."

#: lib/injury_data.dart:266 lib/injury_data.dart:267 lib/injury_data.dart:268 lib/injury_data.dart:269
msgid "kevennä 30–50 %, syvyys kivuttomaan (esim. laatikolle)"
msgstr "kevennä 30–50 %, syvyys kivuttomaan (esim. laatikolle)"

#: lib/injury_data.dart:270 lib/injury_data.dart:271
msgid "kevennä tai nosta korokkeelta, selkä neutraalina"
msgstr "kevennä tai nosta korokkeelta, selkä neutraalina"

#: lib/injury_data.dart:272
msgid "kevyt, lyhyempi liikerata"
msgstr "kevyt, lyhyempi liikerata"

#: lib/injury_data.dart:273 lib/injury_data.dart:274 lib/injury_data.dart:275
msgid "kevennä tai korvaa tuetulla soudulla"
msgstr "kevennä tai korvaa tuetulla soudulla"

#: lib/injury_data.dart:276
