msgstr "Eanet voluma ja jeavddalaš geahpedeamit"

#: lib/ui/intro.dart:361
msgid "Millä välineillä treenaat mieluiten?"
msgstr "Makkár rusttegiiguin hárjehalat buoremusat?"

#: lib/ui/intro.dart:364
msgid "Kaikki käy"
msgstr "Buot heive"

#: lib/ui/intro.dart:364
msgid "Sali, jossa on kaikkea"
msgstr "Sálla mas lea buot"

#: lib/ui/intro.dart:369
msgid "Kyykyt, penkit ja soudut tangolla ja käsipainoilla"
msgstr ""
"Hárjehusat stákkuin ja giehtadeattuiguin (om. Takakyykky, "
"Penkkipunnerrus, Kulmasoutu)"

#: lib/ui/intro.dart:370
msgid "Ohjatut liikeradat, helppo oppia ja säätää"
msgstr "Stivrejuvvon lihkadangeainnut, álki oahppat ja heivehit"

#: lib/ui/intro.dart:371
msgid "Heilautukset, rinnallevedot, ylösnousut, sopii myös kotiin"
msgstr ""
"Kettlebell-hárjehusat (om. swing, clean, get-up), heive maiddái "
"ruoktot"

#: lib/ui/intro.dart:372
msgid ""
"Ilman salia: kotona tai ulkona. Leuanvetoihin riittää ovitanko tai "
"puiston tanko."
msgstr ""
"Sála haga: ruovttus dahje olgun. Bajásgeassimiid várás doarvái "
"uksastággu dahje párkka stággu."

#: lib/ui/intro.dart:385
msgid "Kahvakuulatreenin pääpaino"
msgstr "Kettlebell-hárjehallama váldodeattuhus"

#: lib/ui/intro.dart:389
msgid "Tavallinen ohjelma kahvakuulilla"
msgstr "Dábálaš prográmma kettlebellaiguin"

#: lib/ui/intro.dart:390
msgid "Liikemallit kuten salilla, kahvakuulaliikkeillä"
msgstr "Lihkadanmállet nugo sálas, kettlebell-hárjehusaiguin"

#: lib/ui/intro.dart:398
msgid ""
"Valitse yksi tai useampi. Ohjelma suosii niitä ja käyttää muita vain, "
"jos sopivaa liikettä ei löydy."
msgstr ""
"Vállje ovtta dahje eanet. Prográmma ovddida daid ja geavaha earáid "
"dušše jos heivvolaš hárjehus ii gávdno."

#: lib/ui/intro.dart:399
msgid "Voimanoston kilpaliikkeet tehdään aina tangolla."
msgstr "Fápmoloktema gilvohárjehusat dahkkojuvvojit álo stákkuin."

#: lib/ui/intro.dart:401
msgid "Mitä liikkeitä haluat tehdä?"
msgstr "Makkár hárjehusaid háliidat dahkat?"

#: lib/ui/intro.dart:403
