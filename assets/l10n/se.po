msgid "hidas, ei hyppäävää liikettä"
msgstr "hidas, ei hyppäävää liikettä"

#: lib/injury_data.dart:391
msgid "Polven etuosa lumpion alla (hyppääjän polvi)"
msgstr "Polven etuosa lumpion alla (hyppääjän polvi)"

#: lib/injury_data.dart:392
msgid ""
"Paikallinen kipu heti polvilumpion alapuolella jänteessä. Se pahenee "
"hypyissä ja syvässä kyykyssä. Jänne paranee asteittain lisättävällä "
"raskaalla ja hitaalla kuormituksella, ei levolla."
msgstr ""
"Paikallinen kipu heti polvilumpion alapuolella jänteessä. Se pahenee "
"hypyissä ja syvässä kyykyssä. Jänne paranee asteittain lisättävällä "
"raskaalla ja hitaalla kuormituksella, ei levolla."

#: lib/injury_data.dart:405
msgid ""
"Vaihe 1: isometriset pidot kipua lievittämään. Vaihe 2: raskas hidas "
"vastus (HSR), noin 3 krt/vk ja 12 vk, kuorma noin 15 RM:stä 6 RM:ään. "
"Vaihe 3: nopeat liikkeet ja hypyt, vasta kun raskas kuormitus sujuu. "
"Kipu saa olla enintään 3–5/10."
msgstr ""
"Vaihe 1: isometriset pidot kipua lievittämään. Vaihe 2: raskas hidas "
"vastus (HSR), noin 3 krt/vk ja 12 vk, kuorma noin 15 RM:stä 6 RM:ään. "
"Vaihe 3: nopeat liikkeet ja hypyt, vasta kun raskas kuormitus sujuu. "
"Kipu saa olla enintään 3–5/10."

#: lib/injury_data.dart:414 lib/injury_data.dart:415 lib/injury_data.dart:416 lib/injury_data.dart:417
