"čoahkkáigeasus dahje maŋŋelaš."

#: lib/ui/intro.dart:433
msgid "Kuinka monta kertaa viikossa?"
msgstr "Galle geardde vahkus?"

#: lib/ui/intro.dart:447
msgid "Treenin kesto"
msgstr "Hárjehallama guhkkodat"

#: lib/ui/intro.dart:459
msgid "Toistoalue lisäliikkeissä"
msgstr "Geardduhanguovlu lassehárjehusain"

#: lib/ui/intro.dart:464
msgid "Suositus"
msgstr "Rávvagat"

#: lib/ui/intro.dart:464
