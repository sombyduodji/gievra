msgstr "ristisidevammassa vain fysioterapeutin ohjeen mukaan (usein 90°→45°)"

#: lib/injury_data.dart:410
msgid "Polvi (kierukka / eturistiside), lyhyesti"
msgstr "Polvi (kierukka / eturistiside), lyhyesti"

#: lib/injury_data.dart:411
msgid ""
"Jos polvi turposi vamman jälkeen, lukittuu, pettää tai napsahti, se "
"kuuluu lääkärin tai fysioterapeutin arvioon ennen raskasta "
"harjoittelua. Leikkauksen jälkeen noudata saamaasi kuntoutusohjelmaa."
msgstr ""
"Jos polvi turposi vamman jälkeen, lukittuu, pettää tai napsahti, se "
"kuuluu lääkärin tai fysioterapeutin arvioon ennen raskasta "
"harjoittelua. Leikkauksen jälkeen noudata saamaasi kuntoutusohjelmaa."

#: lib/injury_data.dart:431
msgid "aloita isometrisellä pidolla, sitten kevyt dynaaminen; kipu ≤4/10"
msgstr "aloita isometrisellä pidolla, sitten kevyt dynaaminen; kipu ≤4/10"

