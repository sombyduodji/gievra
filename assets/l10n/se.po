#: lib/injury_data.dart:327
msgid "Lonkan ulkosivu (pakaralihasten jänne)"
msgstr "Lonkan ulkosivu (pakaralihasten jänne)"

#: lib/injury_data.dart:328
msgid ""
"Kipu lonkan ulkosivulla. Se pahenee usein kyljellään maatessa, jalat "
"ristissä istuessa ja yhdellä jalalla seistessä. Jänne ärtyy "
"puristuksesta, kun reisi viedään vartalon keskilinjan yli. Siksi "
"näitä asentoja kannattaa välttää, mutta lihasta vahvistaa."
msgstr ""
"Kipu lonkan ulkosivulla. Se pahenee usein kyljellään maatessa, jalat "
"ristissä istuessa ja yhdellä jalalla seistessä. Jänne ärtyy "
"puristuksesta, kun reisi viedään vartalon keskilinjan yli. Siksi "
"näitä asentoja kannattaa välttää, mutta lihasta vahvistaa."

#: lib/injury_data.dart:341
msgid ""
"Ensin loitontajien isometriset pidot, sitten asteittain raskaampi "
"kuormitus. Käytä vähän puristusta aiheuttavia asentoja."
msgstr ""
"Ensin loitontajien isometriset pidot, sitten asteittain raskaampi "
"kuormitus. Käytä vähän puristusta aiheuttavia asentoja."

