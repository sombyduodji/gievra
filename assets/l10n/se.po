#: lib/injury_data.dart:309
msgid "Lonkan etuosa (lonkankoukistaja)"
msgstr "Lonkan etuosa (lonkankoukistaja)"

#: lib/injury_data.dart:310
msgid ""
"Kipu lonkan etuosassa tai nivusessa. Se pahenee jalan nostossa ja kun "
"takajalan lonkka venyy askelkyykyssä. Kevennä jalannostoja hetkeksi "
"ja vahvista vähitellen."
msgstr ""
"Kipu lonkan etuosassa tai nivusessa. Se pahenee jalan nostossa ja kun "
"takajalan lonkka venyy askelkyykyssä. Kevennä jalannostoja hetkeksi "
"ja vahvista vähitellen."

