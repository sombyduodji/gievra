#: lib/program.dart:1166
msgid ""
"Viikon sarjamäärä jää alle tavoitteen suosituksen: {0}. {1} × {2} min "
"ei riitä enempään; lisää treenipäivä tai pidennä treeniä. "
"Vähemmälläkin kehittyy, kunhan treenaat säännöllisesti."
msgstr ""
"Vahku ráidomearri báhcá vuollel ulbmila rávvagiid: {0}. {1} × {2} min "
"ii doaimma eambbo; lasit hárjehallanbeaivvi dahje guhkit "
"hárjehallama. Unnibuinge ovdána, go hárjehalat jeavddalaččat."

