msgstr "lyhyt liikerata, ylävartalo hieman eteen"

#: lib/injury_data.dart:368
msgid "Polven etuosa (patellofemoraalikipu)"
msgstr "Polven etuosa (patellofemoraalikipu)"

#: lib/injury_data.dart:369
msgid ""
"Kipu polvilumpion ympärillä tai takana. Se pahenee kyykyssä, "
"portaissa ja pitkään istuessa. Lonkan ja reiden lihasten "
"vahvistaminen on paras hoito. Säädä kyykyn syvyys kivun mukaan."
msgstr ""
"Kipu polvilumpion ympärillä tai takana. Se pahenee kyykyssä, "
"portaissa ja pitkään istuessa. Lonkan ja reiden lihasten "
"vahvistaminen on paras hoito. Säädä kyykyn syvyys kivun mukaan."

#: lib/injury_data.dart:395
msgid ""
"vaihe 1: isometrinen pito 5 × 45 s, n. 70 % maksimista, 2 min tauot; "
"vaihe 2: raskas hidas, 3 s ylös / 3 s alas"
msgstr ""
"vaihe 1: isometrinen pito 5 × 45 s, n. 70 % maksimista, 2 min tauot; "
"vaihe 2: raskas hidas, 3 s ylös / 3 s alas"

#: lib/injury_data.dart:396 lib/injury_data.dart:397 lib/injury_data.dart:398 lib/injury_data.dart:399
msgid "raskas hidas tempo (3 s / 3 s), syvyys kipurajan mukaan, 3 krt/vk"
msgstr "raskas hidas tempo (3 s / 3 s), syvyys kipurajan mukaan, 3 krt/vk"

