<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Synkattu treenikansio (Nextcloud, Seafile, Syncthing…) on toisen sovelluksen kirjoittama,
         joten sen lukeminen vaatii "Kaikkien tiedostojen käyttö" -luvan. Pyydetään vasta kun kansio valitaan. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Valinnainen Google Drive -synkronointi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Palautusajastin (valinnainen): ilmoitus ja värinä, kun sarjojen välinen tauko on ohi. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Valinnainen reitin tallennus (GPS): sijainti vain tallennuksen ajan, etualapalveluna ilmoituksen kanssa.
         Taustasijaintia ("Salli aina") ei tarvita, koska tallennus aloitetaan aina sovelluksesta. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Treeni käynnissä (WorkoutService): treeni-ilmoitus etualan palveluna, jottei sovellusta jäädytetä taustalla. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Akunsäästö: Androidin oma kysymys, saako Gievra toimia taustalla (käyttäjä päättää). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Valinnainen sykevyö Bluetoothilla (Polar H10 ym.): haku ja yhteys vain käyttäjän valitsemaan vyöhön.
         Android 12+: BLUETOOTH_SCAN ilman sijaintia (neverForLocation) ja BLUETOOTH_CONNECT; vanhemmissa
         Bluetooth-haku vaatii sijaintiluvan (yllä). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"
        xmlns:tools="http://schemas.android.com/tools" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Sykevyö taustalla (näyttö lukittuna): treenin ja GPS-lenkin etualan palvelu myös connectedDevice-tyyppinä,
         kun vyö on valittu. Ilman sitä OnePlus (OxygenOS 16) katkaisi vyön noin 1,5 min kuluttua. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Health Connect (valinnainen): syke, harjoitukset, kalorit ja askeleet vain treenin aikaväliltä, vain kun käyttäjä
         pyytää treenin jälkeen. Kirjasto vaatii Android 8:n; vanhemmissa Health Connect näkyy "ei saatavilla". -->
    <uses-sdk xmlns:tools="http://schemas.android.com/tools" tools:overrideLibrary="androidx.health.connect.client" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Päivän askeleet: vanhempi historia kuin 30 päivää ennen luvan antamista (käyttäjän pyynnöstä). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Health Connectia käyttävät sovellukset (kellon sovellus, Health Sync …): nimi näkyy "Onko tämä se?"
             -kortissa pakettinimen sijaan. Ne kaikki julistavat tämän aikomuksen; muita sovelluksia ei näe. -->
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
    </queries>
    <application
        android:label="Gievra"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutterin syvälinkit pois: muuten "Avaa sovelluksella" -tiedoston content://-osoite yritetään avata
                 näkymän nimenä (pushNamed), mikä kaatui jokaisella avauksella. Tiedostot luetaan itse (MainActivity). -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect: "miksi sovellus pyytää lupaa" (Android 13 ja vanhemmat) avaa sovelluksen. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- "Avaa sovelluksella" tiedostonhallinnasta, sähköpostista tai viestistä: ohjelmapohja (.gmd), FitNotes-
                 varmuuskopio, Gievran varmuuskopio (.zip), .md-treenit. Tyypin tunnistaa sama koodi kuin Tuo tiedosto
                 -painikkeessa. Tiedostopääte tunnistetaan, kun polku on näkyvissä; muuten Gievra tarjoutuu tuntemattomille
                 tiedostoille ja tarkistaa sisällön itse. Vain content://: file://-osoitetta MainActivity ei lue
                 (hiljainen umpikuja), joten sille ei tarjouduta. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.gmd" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="application/zip" />
            </intent-filter>
            <!-- Jaa → Gievra -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <receiver android:name=".RestAlarmReceiver" android:exported="false" />
        <receiver android:name=".OngoingRestoreReceiver" android:exported="false" />
        <service android:name=".GpsService" android:exported="false" android:foregroundServiceType="location|connectedDevice" />
        <service android:name=".WorkoutService" android:exported="false" android:foregroundServiceType="specialUse|connectedDevice">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workout in progress: rest timer and heart rate strap during a gym workout or timed activity" />
        </service>
        <!-- Vikailmoituksen liitteet sähköpostisovellukselle (ks. MainActivity). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_paths" />
        </provider>
        <!-- Health Connect (Android 14+): lupien käyttötarkoitus avaa sovelluksen. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="mailto" /></intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
